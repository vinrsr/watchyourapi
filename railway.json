{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm install && npm run build --workspace=@watchyourapi/api"
    },
    "deploy": {
        "startCommand": "npm run start --workspace=@watchyourapi/api",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
    }
}